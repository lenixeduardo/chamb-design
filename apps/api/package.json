{
  "name": "@opendesign/api",
  "version": "0.1.0",
  "private": true,
  "description": "Optional sync, collaboration and persistence server for Charm-Design",
  "license": "MIT",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@opendesign/ai": "workspace:*",
    "@opendesign/components": "workspace:*",
    "@opendesign/core": "workspace:*",
    "@opendesign/exporters": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.0.0",
    "ioredis": "^5.9.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "prisma": "^7.9.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
