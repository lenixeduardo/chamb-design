# Postgres connection used by Prisma.
DATABASE_URL="postgresql://opendesign:opendesign@localhost:5432/opendesign"

# Optional. When unset the server falls back to an in-process cache, so the API
# runs with no infrastructure beyond Postgres.
REDIS_URL="redis://localhost:6379"

PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Model provider keys. Only the ones you set become selectable in the editor.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
