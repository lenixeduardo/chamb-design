{
  "name": "opendesign",
  "version": "0.1.0",
  "private": true,
  "description": "Open source AI-first visual design & development platform",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "examples": "node scripts/generate-template-examples.mjs"
  },
  "devDependencies": {
    "@opendesign/components": "workspace:*",
    "@opendesign/core": "workspace:*",
    "@opendesign/exporters": "workspace:*",
    "@opendesign/mcp": "workspace:*",
    "@opendesign/plugin-chamb-brand": "workspace:*",
    "@opendesign/templates": "workspace:*",
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.10.7",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
